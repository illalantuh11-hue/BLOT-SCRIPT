local function choice(page, options, default, cb)
	local holder = new("Frame", {
		Size = UDim2.new(1, -6, 0, #options * 34), BackgroundTransparency = 1,
		LayoutOrder = nextLO(),
	}, page)
	new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, holder)
	local btns = {}
	local function render(sel)
		for key, b in pairs(btns) do
			b.BackgroundColor3 = (key == sel) and C.on or C.item
			b.TextColor3 = (key == sel) and C.bg or C.text
		end
	end
	for i, opt in ipairs(options) do
		local b = new("TextButton", {
			Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = C.item, Text = opt[2],
			TextColor3 = C.text, Font = Enum.Font.Gotham, TextSize = 13, LayoutOrder = i,
		}, holder)
		corner(b, 6)
		btns[opt[1]] = b
		connect(b.MouseButton1Click, function()
			render(opt[1])
			cb(opt[1])
		end)
	end
	render(default)
end

---------------------------------------------------------------- ESP & MACHINE PROGRESS
local machineKeyword = "generator"
local itemKeywords = { "key", "medkit", "battery", "tape", "item", "apple", "cookie" }
local tracked = {}

local function getMachineProgress(model)
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("IntValue") or desc:IsA("NumberValue") then
			if desc.Name:lower():find("progress") or desc.Name:lower():find("completion") or desc.Name:lower():find("hp") then
				return math.clamp(math.floor(desc.Value), 0, 100)
			end
		end
		if desc:GetAttribute("Progress") then
			return math.clamp(math.floor(desc:GetAttribute("Progress")), 0, 100)
		end
	end
	return nil
end

local function applyEntry(e)
	local show = state.esp and state.cats[e.cat] and (e.cat ~= "twisted" or state.rarity[e.rarity])
	local style = state.style
	e.hl.Enabled = show and style ~= "text"
	e.hl.FillTransparency = (style == "outline") and 1 or 0.6
	if e.billboard then
		e.billboard.Enabled = show and (style == "full" or style == "text")
	end
end

local function refreshESP()
	for _, e in pairs(tracked) do applyEntry(e) end
end

local function removeESP(model)
	local e = tracked[model]
	if not e then return end
	if e.hl then e.hl:Destroy() end
	if e.billboard then e.billboard:Destroy() end
	tracked[model] = nil
end

local function track(model, cat, color, labelText, rarity)
	if tracked[model] then return end

	local hl = new("Highlight", {
		FillColor = color, OutlineColor = color, FillTransparency = 0.6,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Adornee = model, Enabled = false,
	}, model)

	local billboard
	local part = model.PrimaryPart
		or model:FindFirstChild("HumanoidRootPart")
		or model:FindFirstChildWhichIsA("BasePart", true)
	if part then
		billboard = new("BillboardGui", {
			Size = UDim2.new(0, 140, 0, 36), StudsOffset = Vector3.new(0, 3, 0),
			AlwaysOnTop = true, Adornee = part, Enabled = false,
		}, gui)
		local textLabel = new("TextLabel", {
			Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, TextColor3 = color,
			TextStrokeTransparency = 0.3, Font = Enum.Font.GothamBold, TextSize = 14,
			Text = labelText,
		}, billboard)
		
		if cat == "machines" then
			task.spawn(function()
				while billboard and billboard.Parent do
					local prog = getMachineProgress(model)
					if prog then
						textLabel.Text = model.Name .. " [" .. prog .. "%]"
					else
						textLabel.Text = model.Name
					end
					task.wait(0.5)
				end
			end)
		end
	end

	local e = { hl = hl, billboard = billboard, cat = cat, rarity = rarity, textLbl = billboard and billboard:FindFirstChildOfClass("TextLabel") }
	tracked[model] = e
	applyEntry(e)
	model.AncestryChanged:Connect(function(_, parent)
		if not parent then removeESP(model) end
	end)
end

local function insideTracked(model)
	local p = model.Parent
	while p and p ~= workspace do
		if tracked[p] then return true end
		p = p.Parent
	end
	return false
end

local function isItem(name)
	local lower = name:lower()
	for _, kw in ipairs(itemKeywords) do
		if lower:find(kw, 1, true) then return true end
	end
	return false
end

local function scan(obj)
	if not obj:IsA("Model") then return end
	local rarity = rarities[obj.Name]
	if rarity then
		local shown = obj.Name:gsub("Monster$", "")
		local text = shown .. " [" .. rarity .. "]" .. (grabbers[obj.Name] and "\nGRABBER!" or "")
		track(obj, "twisted", state.colors.twisted, text, rarity)
	elseif obj.Name:lower():find(machineKeyword, 1, true) and not insideTracked(obj) and not Players:GetPlayerFromCharacter(obj) then
		track(obj, "machines", state.colors.machines, obj.Name)
	elseif isItem(obj.Name) and not insideTracked(obj) then
		track(obj, "items", state.colors.items, obj.Name)
	end
end

for _, d in ipairs(workspace:GetDescendants()) do scan(d) end
connect(workspace.DescendantAdded, function(d) task.defer(scan, d) end)

local function trackPlayer(plr)
	if plr == lp then return end
	local function onChar(ch)
		task.spawn(function()
			ch:WaitForChild("HumanoidRootPart", 5)
			track(ch, "players", state.colors.players, plr.Name)
		end)
	end
	if plr.Character then onChar(plr.Character) end
	connect(plr.CharacterAdded, onChar)
end
for _, plr in ipairs(Players:GetPlayers()) do trackPlayer(plr) end
connect(Players.PlayerAdded, trackPlayer)

